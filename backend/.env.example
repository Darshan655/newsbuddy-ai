# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
SECRET_KEY=change-this-in-production-use-a-long-random-string
DEBUG=true

# ── Database (Supabase or local PostgreSQL) ───────────────────────────────────
# Supabase: Settings → Database → Connection String (URI)
DATABASE_URL=postgresql://postgres:yourpassword@db.xxxx.supabase.co:5432/postgres

# ── Redis (Railway.app free tier or local) ────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── OpenAI ────────────────────────────────────────────────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ── VAPI (Voice Calling) ──────────────────────────────────────────────────────
# https://dashboard.vapi.ai → API Keys
VAPI_API_KEY=vapi-...
# https://dashboard.vapi.ai → Phone Numbers → your number ID
VAPI_PHONE_NUMBER_ID=...

# ── Twilio (WhatsApp) ─────────────────────────────────────────────────────────
# https://console.twilio.com
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# WhatsApp sandbox: whatsapp:+14155238886
# Production: whatsapp:+91XXXXXXXXXX (after WhatsApp Business approval)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Call Settings ─────────────────────────────────────────────────────────────
MAX_CALL_DURATION_MINUTES=10
CALL_RETRY_ATTEMPTS=2
CALL_RETRY_DELAY_MINUTES=5
FREE_TIER_CALLS_PER_WEEK=3

# ── Defaults ──────────────────────────────────────────────────────────────────
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_LANGUAGE=hi


